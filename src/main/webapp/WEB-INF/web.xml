<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Gestion RH Entreprise</display-name>
    
    <!-- Servlets principales -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.rh.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.rh.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.rh.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Gestion des départements -->
    <servlet>
        <servlet-name>ListeDepartementServlet</servlet-name>
        <servlet-class>com.rh.servlet.ListeDepartementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListeDepartementServlet</servlet-name>
        <url-pattern>/departement/liste</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DepartementServlet</servlet-name>
        <servlet-class>com.rh.servlet.DepartementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepartementServlet</servlet-name>
        <url-pattern>/departement</url-pattern>
    </servlet-mapping>

    <!-- Gestion des employés -->
    <servlet>
        <servlet-name>EmployeServlet</servlet-name>
        <servlet-class>com.rh.servlet.EmployeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeServlet</servlet-name>
        <url-pattern>/employe</url-pattern>
    </servlet-mapping>

    <!-- Gestion des contrats -->
    <servlet>
        <servlet-name>ContratServlet</servlet-name>
        <servlet-class>com.rh.servlet.ContratServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContratServlet</servlet-name>
        <url-pattern>/contrat</url-pattern>
    </servlet-mapping>

    <!-- Gestion des congés -->
    <servlet>
        <servlet-name>CongeServlet</servlet-name>
        <servlet-class>com.rh.servlet.CongeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CongeServlet</servlet-name>
        <url-pattern>/conge</url-pattern>
    </servlet-mapping>

    <!-- Gestion des fiches de paie -->
    <servlet>
        <servlet-name>FichePaieServlet</servlet-name>
        <servlet-class>com.rh.servlet.FichePaieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FichePaieServlet</servlet-name>
        <url-pattern>/fichepaie</url-pattern>
    </servlet-mapping>

    <!-- Statistiques -->
    <servlet>
        <servlet-name>StatistiquesServlet</servlet-name>
        <servlet-class>com.rh.servlet.StatistiquesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatistiquesServlet</servlet-name>
        <url-pattern>/statistiques</url-pattern>
    </servlet-mapping>

    <!-- Exports -->
    <servlet>
        <servlet-name>CSVServlet</servlet-name>
        <servlet-class>com.rh.servlet.CSVServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CSVServlet</servlet-name>
        <url-pattern>/csv/employes</url-pattern>
    </servlet-mapping>

    <!-- PDF Servlets -->
    <servlet>
        <servlet-name>PDFEmployesServlet</servlet-name>
        <servlet-class>com.rh.servlet.PDFEmployesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PDFEmployesServlet</servlet-name>
        <url-pattern>/pdf/employes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PDFFichePaieServlet</servlet-name>
        <servlet-class>com.rh.servlet.PDFFichePaieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PDFFichePaieServlet</servlet-name>
        <url-pattern>/pdf/fichepaie</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PDFContratServlet</servlet-name>
        <servlet-class>com.rh.servlet.PDFContratServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PDFContratServlet</servlet-name>
        <url-pattern>/pdf/contrat</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PDFRapportServlet</servlet-name>
        <servlet-class>com.rh.servlet.PDFRapportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PDFRapportServlet</servlet-name>
        <url-pattern>/pdf/rapport</url-pattern>
    </servlet-mapping>

    <!-- SMS -->
    <servlet>
        <servlet-name>SmsServlet</servlet-name>
        <servlet-class>com.rh.servlet.SmsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SmsServlet</servlet-name>
        <url-pattern>/sms/send</url-pattern>
    </servlet-mapping>

    <!-- Messagerie -->
    <servlet>
        <servlet-name>MessageServlet</servlet-name>
        <servlet-class>com.rh.servlet.MessageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MessageServlet</servlet-name>
        <url-pattern>/message</url-pattern>
    </servlet-mapping>

    <!-- Pages d'erreur -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vues/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vues/error/500.jsp</location>
    </error-page>
    
    <servlet>
    <servlet-name>ChangerMotDePasseServlet</servlet-name>
    <servlet-class>com.rh.servlet.ChangerMotDePasseServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>ChangerMotDePasseServlet</servlet-name>
    <url-pattern>/changerMotDePasse</url-pattern>
</servlet-mapping>

    <!-- Filtre d'autorisation -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.rh.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
</web-app>